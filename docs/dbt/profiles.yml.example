# Copy to: %USERPROFILE%\.dbt\profiles.yml  (Windows)
#          ~/.dbt/profiles.yml             (Linux/macOS)
#
# Do NOT commit real credentials to the repository.

anatel_dbt:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: data/duckdb/anatel.duckdb
      extensions:
        - httpfs
        - parquet
      settings:
        s3_region: us-east-1
        s3_endpoint: localhost:4566
        s3_access_key_id: test
        s3_secret_access_key: test
        s3_use_ssl: false
        s3_url_style: path
